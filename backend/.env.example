PORT=4000
DATABASE_URL="file:./data/coachconnect.db"
JWT_SECRET=change-this-to-a-long-random-string
FRONTEND_ORIGIN=http://localhost:5173

# Seeded on first boot if no user exists yet — change the password after first login isn't
# supported yet, so pick a strong one now.
ADMIN_EMAIL=maroof@example.com
ADMIN_PASSWORD=change-this-password

# Optional: enables the AI draft-message helper (Step 4 feature). Leave blank to disable it.
ANTHROPIC_API_KEY=
